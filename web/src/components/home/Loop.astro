---
import { t, type Lang, type StringKey } from '../../i18n';
import { texMap } from '../../lib/math';
import ProofWorkshop, { WORKSHOP_TEX } from '../islands/ProofWorkshop';
interface Props { lang: Lang }
const { lang } = Astro.props;
const T = (k: StringKey) => t(lang, k);
---
<!-- La boucle -->
<section class="section paper-alt" id="boucle">
  <div class="container">
    <div class="section-head reveal">
      <p class="eyebrow eb-gold" set:html={T('loop.eyebrow')} />
      <h2 class="h2" set:html={T('loop.title')} />
      <p class="lead" set:html={T('loop.lead')} />
    </div>

    <ol class="steps">
      <li class="step card reveal" style="--accent: var(--gold); --delay:0s">
        <span class="step-n">01</span>
        <h3 set:html={T('loop.s1.t')} />
        <p class="step-engine">LLM · MCTS</p>
        <p set:html={T('loop.s1.d')} />
      </li>
      <li class="step card reveal" style="--accent: var(--coral); --delay:.08s">
        <span class="step-n">02</span>
        <h3 set:html={T('loop.s2.t')} />
        <p class="step-engine">SymPy</p>
        <p set:html={T('loop.s2.d')} />
      </li>
      <li class="step card reveal" style="--accent: var(--teal); --delay:.16s">
        <span class="step-n">03</span>
        <h3 set:html={T('loop.s3.t')} />
        <p class="step-engine">Lean 4</p>
        <p set:html={T('loop.s3.d')} />
      </li>
      <li class="step card reveal" style="--accent: var(--ink); --delay:.24s">
        <span class="step-n">04</span>
        <h3 set:html={T('loop.s4.t')} />
        <p class="step-engine" set:html={T('loop.s4.e')} />
        <p set:html={T('loop.s4.d')} />
      </li>
    </ol>

    <div class="reveal">
      <ProofWorkshop client:visible lang={lang} math={texMap(WORKSHOP_TEX)} />
    </div>
    <p class="fine-print reveal" set:html={T('ws.note')} />
  </div>
</section>
