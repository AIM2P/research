---
import { t, type Lang, type StringKey } from '../../i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const T = (k: StringKey) => t(lang, k);
---
<!-- Les quatre verrous -->
<section class="section paper-alt" id="verrous">
  <div class="container">
    <div class="section-head reveal">
      <p class="eyebrow eb-coral" set:html={T('gap.eyebrow')} />
      <h2 class="h2" set:html={T('gap.title')} />
    </div>
    <div class="gap-grid">
      <article class="gap card reveal">
        <div class="gap-top"><span class="gap-n">01</span><svg class="ico gap-lock"><use href="#i-lock"/></svg></div>
        <h3 set:html={T('gap.g1.t')} />
        <p set:html={T('gap.g1.d')} />
      </article>
      <article class="gap card reveal" style="--delay:.06s">
        <div class="gap-top"><span class="gap-n">02</span><svg class="ico gap-lock"><use href="#i-lock"/></svg></div>
        <h3 set:html={T('gap.g2.t')} />
        <p set:html={T('gap.g2.d')} />
      </article>
      <article class="gap card reveal" style="--delay:.12s">
        <div class="gap-top"><span class="gap-n">03</span><svg class="ico gap-lock"><use href="#i-lock"/></svg></div>
        <h3 set:html={T('gap.g3.t')} />
        <p set:html={T('gap.g3.d')} />
      </article>
      <article class="gap card reveal" style="--delay:.18s">
        <div class="gap-top"><span class="gap-n">04</span><svg class="ico gap-lock"><use href="#i-lock"/></svg></div>
        <h3 set:html={T('gap.g4.t')} />
        <p set:html={T('gap.g4.d')} />
      </article>
    </div>
  </div>
</section>
