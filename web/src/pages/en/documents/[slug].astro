---
import DocPage from '../../../components/pages/DocPage.astro';
import { DOCS, type DocMeta } from '../../../lib/docs';

export function getStaticPaths() {
  return DOCS.map((doc) => ({ params: { slug: doc.slug }, props: { doc } }));
}
const { doc } = Astro.props as { doc: DocMeta };
---
<DocPage lang="en" doc={doc} />
